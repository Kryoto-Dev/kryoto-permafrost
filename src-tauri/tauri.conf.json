{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryoto Permafrost", "version": "0.1.0", "identifier": "to.kryo.permafrost",
  "build": { "devUrl": "http://localhost:1426", "frontendDist": "../dist", "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build" },
  "app": {
    "windows": [{ "label": "main", "title": "Kryoto Permafrost", "width": 1120, "height": 760, "minWidth": 960, "minHeight": 640, "center": true, "decorations": false, "theme": "Dark", "backgroundColor": "#0a0a0a", "dragDropEnabled": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"], "publisher": "Kryoto", "homepage": "https://kryo.to", "copyright": "Kryoto" }
}
