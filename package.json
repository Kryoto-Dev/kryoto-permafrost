{
  "name": "kryoto-permafrost",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Freeze a game folder into a .kryo repack with its own setup.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "stub": "node scripts/stub.mjs",
    "brand": "node scripts/brand.mjs",
    "app:dev": "node scripts/app.mjs dev",
    "app:build": "node scripts/app.mjs build",
    "test": "cargo test -p kryo",
    "check": "tsc --noEmit && cargo test -p kryo && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
